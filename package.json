{
  "name": "kchristakis52.github.io",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx --yes serve out",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts .github \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check src scripts .github \"*.{json,mjs,ts}\"",
    "check:links": "node scripts/check-links.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.16.0 autorun"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
